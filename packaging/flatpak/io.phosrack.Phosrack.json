{
  "app-id": "io.phosrack.Phosrack",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "phosrack",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=xdg-run/pipewire-0",
    "--talk-name=org.kde.kwalletd6",
    "--socket=pulseaudio",
    "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess",
    "--filesystem=/opt/google/chrome/WidevineCdm:ro"
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "*.a"
  ],
  "modules": [
    {
      "name": "phosrack",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_TESTING=OFF",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPHOSRACK_SPOTIFY_CLIENT_ID="
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".flatpak-builder",
            "flatpak-build",
            "repo",
            "releases",
            "dist",
            "build",
            "build-win"
          ]
        }
      ]
    }
  ],
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ]
}
